<aura:component controller="AuraTableController">
    <aura:attribute name="recList" type="Account[]"/>
    <aura:attribute name="columns" type="List"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    123
	<lightning:datatable
                keyField="id"
                data="{! v.recList }"
                columns="{! v.columns }"
                hideCheckboxColumn="true"/>
</aura:component>