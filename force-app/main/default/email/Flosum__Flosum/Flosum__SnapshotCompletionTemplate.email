<messaging:emailTemplate subject="A snapshot on org {!relatedTo.Flosum__Organisation__r.Name} is complete." recipientType="User" relatedToType="Flosum__Snapshot__c">
<messaging:htmlEmailBody >
        <html>
            <body>
                <p>Dear {!recipient.FirstName},</p>
                <p>Flosum has created a snapshot on org {!relatedTo.Flosum__Organisation__r.Name}.</p>
                <p>The details of the Snapshot can be seen here:</p>
                <Flosum:NotificationComponent recordId="{!relatedTo.Id}"/>
                <Flosum:FlosumLogo />
            </body>
        </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>