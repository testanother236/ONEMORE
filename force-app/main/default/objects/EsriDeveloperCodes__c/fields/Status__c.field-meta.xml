<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Pending, Active, Expired, Canceled,Non Active</description>
    <externalId>false</externalId>
    <formula>IF( Cancel__c = true, &apos;Canceled&apos;, 
IF(Today() &gt; EndDate__c , &apos;Expired&apos;, 
IF(StartDate__c &gt; Today(), &apos;Pending&apos;, 
IF(AND(StartDate__c &lt;= TODAY(), Today() &lt;= EndDate__c ), &apos;Active&apos;,&apos;Non Active&apos;) 
) 
) 
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Pending, Active, Expired, Canceled,Non Active</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
