        // used to repack all data into componentMetaMap
        function proccesFiles() {
            //return;
            ////console.log('process files');
            ////console.log('fileIndex '+fileIndex);
            const buildJSZip = (item) => {
                var profile;
                var fileZip = new JSZip();
                let isInnerZip = false
                try{
                    if (item.MetaType === 'StaticResource' && fileMap[item.key + '-meta.xml'] != undefined){
                        let x2js = new X2JS({ useDoubleQuotes: true, stripWhitespaces: false, escapeMode: true });
                        let metaObj = x2js.xml_str2json(unpack(fileMap[item.key + '-meta.xml'].data));
                        isInnerZip =
                          metaObj.StaticResource.contentType == 'application/zip' ||
                          metaObj.StaticResource.contentType == 'application/x-zip-compressed';
                    }
                }
                catch (e){
                    console.log(e);
                }

                if (bundleTypes.includes(item.MetaType) || (vlocityTypes.includes(item.MetaType) && isVlocityCommit)) {
                    var auraMap = auraFileMap[item.File_Name];
                    //////console.log('process auar '+JSON.stringify(auraMap));
                    if (auraMap != undefined) {
                        for (var fName in auraMap) {
                            fileZip.file(fName, unpack(auraMap[fName].data), { binary: false });
                        }

                        if (item.MetaType == 'ExperienceBundle') {
                            var key = item.File_Name.slice(0, item.File_Name.lastIndexOf('/'));
                            var expMap = auraFileMap[key];
                            if (expMap != undefined && expMap[item.File_Name + '.site-meta.xml'] != undefined) {
                                fileZip.file(item.File_Name + '.site-meta.xml', unpack(expMap[item.File_Name + '.site-meta.xml'].data), {
                                    binary: false
                                });
                            }
                        }
                    }
                    auraFileMap[item.File_Name] = null;
                } else if (isVeevaCommit) {
                    if (fileMap[item.key]) {
                        const dependencyFileName = convertVeevaMdlToDependencyExtension(item.File_Name);
                        const dependencyKey = convertVeevaMdlToDependencyExtension(item.key);

                        fileZip.file(item.File_Name, unpack(fileMap[item.key].data), { binary: false });

                        if (fileMap[dependencyKey]) {
                            fileZip.file(dependencyFileName, unpack(fileMap[dependencyKey].data), { binary: false });
                        }
                    }
                } else {
                    if (fileMap[item.key + '-meta.xml'] != undefined) {
                        fileZip.file(item.File_Name + '-meta.xml', unpack(fileMap[item.key + '-meta.xml'].data), { binary: false });
                        fileMap[item.key + '-meta.xml'] = {};
                    }
                    if (item.MetaType == 'Profile' || item.MetaType == 'PermissionSet') {
                        profile = fileMap[item.key].data;
                        fileZip.file(item.File_Name, unpack(profile, true), { binary: false });
                    } else if (CTP_subFolderTypeMap[item.MetaType] != undefined) {
                        var tempFileName = '';
                        if (
                          CTP_subFolderTypeMap[item.MetaType] == 'Dashboard' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'DashboardFolder'
                        )
                            tempFileName = item.File_Name.replace('dashboards/', '');
                        else if (
                          CTP_subFolderTypeMap[item.MetaType] == 'Report' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'ReportFolder'
                        )
                            tempFileName = item.File_Name.replace('reports/', '');
                        else if (
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailFolder' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailTemplate' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailTemplateFolder'
                        )
                            tempFileName = item.File_Name.replace('email/', '');

                        var parentFolderName = '';
                        if (
                          CTP_subFolderTypeMap[item.MetaType] == 'Dashboard' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'DashboardFolder'
                        )
                            parentFolderName = 'dashboards/';
                        else if (
                          CTP_subFolderTypeMap[item.MetaType] == 'Report' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'ReportFolder'
                        )
                            parentFolderName = 'reports/';
                        else if (
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailFolder' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailTemplate' ||
                          CTP_subFolderTypeMap[item.MetaType] == 'EmailTemplateFolder'
                        )
                            parentFolderName = 'email/';

                        var startsWithString = (folderMap[item.MetaType] != undefined ? folderMap[item.MetaType] : item.MetaType) + '#';

                        for (var mapKey in fileMap) {
                            if (mapKey != undefined) {
                                if (mapKey.endsWith(tempFileName) && mapKey.startsWith(startsWithString + '' + parentFolderName)) {
                                    //var fileZip = new JSZip();
                                    //tempMeta.Id = metId;
                                    //tempMeta.crc32 = fileMap[mapKey].crc32;
                                    //tempMeta.MetaType = item.MetaType;
                                    //tempMeta.API_Name = item.API_Name;
                                    //tempMeta.File_Name = item.File_Name;
                                    //tempMeta.key = item.key;
                                    fileZip.file(item.File_Name, unpack(fileMap[mapKey].data), { binary: false });
                                    // tempMeta.data = fileZip.generate({type:"base64",compression:"DEFLATE"});
                                    // break;
                                }
                            }
                        }
                    } else if (childMap[item.MetaType] == undefined) {
                        if (isInnerZip){
                            fileZip.file(item.File_Name, unpack(fileMap[item.key].data), { binary: true });
                        } else {
                            if (isEditable(item.File_Name)){
                                fileZip.file(item.File_Name, unpack(fileMap[item.key].data), { binary: false });
                            } else {
                                fileZip.file(item.File_Name, unpack(fileMap[item.key].data), { binary: true });
                            }
                        }
                    } else {
                        //inner components

                        fileZip.file(item.File_Name, unpack(fileMap[item.key].data), { binary: false });
                    }
                    fileMap[item.key] = {};
                }

                return fileZip;
            };

            if (metaFoundMap[commitIds[fileIndex]] != undefined) {
                var isDeployNeeded = false;
                var item = metaFoundMap[commitIds[fileIndex]];
                //console.log('process item'+JSON.stringify(item));
                //console.log('item.MetaType--'+item.MetaType);

                item.data = buildJSZip(item).generate({ type: 'base64', compression: 'DEFLATE' });

                if (item.data != 'UEsFBgAAAAAAAAAAAAAAAAAAAAAAAA==') {
                    //Empty zip
                    if (item.data.length + bodySize > ZIPPACK_LIMIT || currentIndex > 500) {
                        if (isMapNonEmpty(componentMetaMap)) {
                            var commitObj = new Object();
                            commitObj.dataMap = componentMetaMap;
                            commitObj.metaIds = metaIds;
                            ComponentAttachmentWraperList.push(commitObj);
                            bodySize = 0;
                            componentMetaMap = {};
                            metaIds = [];
                            isDeployNeeded = true;
                            currentIndex = 0;
                        }
                    }
                    bodySize = bodySize + item.data.length;
                    var newObj = new Object();
                    newObj.data = item.data;
                    newObj.crc32 = item.crc32;
                    newObj.filename = item.File_Name;
                    let key;

                    // Add duplicates for Vlocity
                    if (vlocityTypes.includes(item.MetaType) && isVlocityCommit) {
                        /*if (item.vlocityCompName) {
                            key = item.MetaType + '#' + item.vlocityCompName;
                        } else {*/
                        key = item.MetaType + '#' + item.API_Name;
                        //}
                    } else {
                        key = item.MetaType + '#' + item.API_Name;
                    }
                    componentMetaMap[key] = newObj;
                    metaIds.push(commitIds[fileIndex]);
                    metaFoundMap[commitIds[fileIndex]] = {};
                    currentIndex++;
                } else {
                    excludedFiles++;
                }
            } else {
                //////console.log('Item not found in zip.');
            }

            fileIndex++;
            if (commitIds.length > fileIndex && isDeployNeeded == false) {
                setTimeout(function () {
                    proccesFiles();
                });
            } else {
                finishCommit();
            }
        }

