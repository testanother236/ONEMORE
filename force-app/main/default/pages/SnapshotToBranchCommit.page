        function getPosition(string, subString, index) {
            //function for getting INDEX of Substring in String.
            /*
                const string = "XYZ 123 ABC 456 ABC 789 ABC";
                getPosition(string, 'ABC', 2) // -->  will return 16
            */
            return string.split(subString, index).join(subString).length;
        }
        function getAuraName(name, tempComponentType) {
            // aura/Test => Test,  aura/TestOne/onessd => Test
            if (name == undefined || name == '') return;
            if (
              name.indexOf('aura/') != 0 &&
              name.indexOf('lwc/') != 0 &&
              name.indexOf('experiences/') != 0 &&
              name.indexOf('waveTemplates/') != 0 &&
              name.indexOf('digitalExperiences/') != 0 &&
              name.indexOf('genAiFunctions/') != 0 &&
              name.indexOf('appTemplates/') != 0 &&
              name.indexOf('lightningTypes/') != 0 &&
              name.indexOf('genAiPlannerBundles/') != 0 &&
              name.indexOf('contentTypes/') != 0 &&
              name.indexOf('aiAuthoringBundles/') != 0 &&
              !vlocityTypes.includes(name.split('/')[0])
            )
                return;
            if (name.lastIndexOf('/') > 5 && name.lastIndexOf('/') != name.length - 1) {
                var fullName;
                if (name.indexOf('digitalExperiences/') == 0) {
                    const position = tempComponentType == 'DigitalExperienceBundle' ? 3 : 5;
                    fullName = name.slice(0, getPosition(name, '/', position));
                } else {
                    fullName = name.slice(0, getPosition(name, '/', 2)); //name.lastIndexOf('/');
                }
                //console.log(name + '=>' + fullName);
                //console.log('allCompFilter');
                //console.log(allCompFilter);

                if (allCompFilter[fullName] != undefined) {
                    return fullName;
                } else if (name.indexOf('experiences/') == 0 || name.indexOf('waveTemplates/') == 0) {
                    if (fullName.lastIndexOf('/') != -1) {
                        fullName = fullName.slice(0, fullName.lastIndexOf('/'));
                    }
                    //console.log('=>' + fullName);
                    return fullName;
                }
            }
            return;
        }
        function isEditable(fileName) {
            if (fileName == undefined) return false;
            var n = fileName.lastIndexOf('.');
            if (n < 0) return false;
            var ext = fileName.substr(n);
            return EDITABLE_EXT.includes(ext);
        }

        // one-thread function
        function createFileMap(tempComponentType, tempZip, callback) {
            const isVlocity = vlocityTypes.includes(tempComponentType) && isVlocityCommit;
            ///console.log('createFileMap for'+tempComponentType);
            let isInnerZip = false;
            if (tempComponentType == 'StaticResource') {
                isInnerZip = isInnerZipContains(tempZip);
            }
            if (tempComponentType == 'Profile' || tempComponentType == 'PermissionSet') {
                tempZip.remove('objects');
                tempZip.remove('classes');
                tempZip.remove('pages');
                tempZip.remove('layouts');
                tempZip.remove('tabs');
                tempZip.remove('applications');
                tempZip.remove('dataSources');
                tempZip.remove('customPermissions');
                for (var fileName in tempZip.files) {
                    //if (isFiltered(tempComponentType,fileName) == false) continue;
                    if (
                      fileName != undefined &&
                      (fileName.indexOf('profiles/') == 0 || fileName.indexOf('permissionsets/') == 0) &&
                      tempZip.files[fileName].dir == false
                    ) {
                        var fileData = tempZip.files[fileName].asText();
                        fileMap[tempComponentType + '#' + fileName] = getCrcWithData(fileData, { compress: true }); // Profile or PermissionSet
                    }
                }
                joinThreads(callback);
            } else if (bundleTypes.includes(tempComponentType) || isVlocity) {
                // process aura components
                for (var fileName in tempZip.files) {
                    // console.log('fileName= '+ fileName);
                    if (tempZip.files[fileName].dir == false) {
                        var name = getAuraName(fileName, tempComponentType);
                        //console.log('name= '+ name);
                        if (name == undefined) continue;
                        //name = tempComponentType + '#' + name;
                        var descriptor = Object();
                        if (auraFileMap[name] != undefined) {
                            descriptor = auraFileMap[name];
                        }
                        var fileData = tempZip.files[fileName].asText();
                        //console.log('fileData='+fileData);
                        descriptor[fileName] = getCrcWithData(fileData); // any (incl. apex cls,pages,etc) except inners
                        auraFileMap[name] = descriptor;
                        //console.log(auraFileMap);
                    }
                }
                joinThreads(callback);
            } else if (childMap[tempComponentType] == undefined) {
                for (var fileName in tempZip.files) {
                    //if (isFiltered(tempComponentType,fileName) == false) continue;
                    if (
                      fileName != undefined &&
                      fileName.charAt(fileName.length - 1) != '/' &&
                      fileName != 'package.xml' &&
                      fileName != 'undefined' &&
                      tempZip.files[fileName].dir == false
                    ) {

                        if (isInnerZip && !fileName.endsWith('.resource-meta.xml')) {
                            let fileData = tempZip.files[fileName].asBinary();
                            fileMap[tempComponentType + '#' + fileName] = getCrcWithData(fileData, { isInnerZip: true }); // static resource with inner zip
                        } else {
                            if (isEditable(fileName)){
                                let fileData = tempZip.files[fileName].asText();
                                fileMap[tempComponentType + '#' + fileName] = getCrcWithData(fileData); // any (incl. apex cls,pages,etc) except inners
                            } else {
                                let fileData = tempZip.files[fileName].asBinary();
                                fileMap[tempComponentType + '#' + fileName] = getCrcWithData(fileData); // any (incl. apex cls,pages,etc) except inners
                            }
                        }
                    }
                }
                joinThreads(callback);
            } else {
                // process inner components
                var fileList = [];
                for (var fileName in tempZip.files) {
                    //if (isFiltered(tempComponentType,fileName) == false) continue;
                    if (
                      fileName != undefined &&
                      fileName.charAt(fileName.length - 1) != '/' &&
                      fileName != 'package.xml' &&
                      fileName != 'undefined' &&
                      tempZip.files[fileName].dir == false
                    ) {
                        fileList.push(fileName);
                        fileMap = {
                            ...fileMap,
                            ...getChildXMLList({
                                xml: tempZip.files[fileName].asText(),
                                type: tempComponentType,
                                fileName: fileName,
                                includeCRC: true,
                                includeData: true
                            })
                        };
                    }
                }
                if (fileList.length > 0) {
                    processInnerComponents(tempComponentType, fileList, tempZip.files, callback);
                } else {
                    joinThreads(callback);
                }
            }
        }

        // Joining threads, meaning that the callback only will
        // be performed when ALL parallel threads have executed
        function joinThreads(callback) {
            left_to_resolve--;
            if (left_to_resolve == 0 && callback !== null && callback != undefined) {
                // call only if the thread is the last
                callback();
            }
        }

        function processInnerComponents(componentType, list, map, callback) {
            if (list.length == 0) {
                joinThreads(callback);
            } else {
                var fileName = list.shift(); // get the 1st element

                fileMap = {
                    ...fileMap,
                    ...getChildXMLList({
                        xml: map[fileName].asText(),
                        type: componentType,
                        fileName: fileName,
                        includeCRC: true,
                        includeData: true
                    })
                };

                setTimeout(function () {
                    processInnerComponents(componentType, list, map, callback);
                }, 5);
            }
        }

        function setAll(array, isAllChecked) {
            for (var index = 0; index < array.length; index++) {
                if (isAllChecked) array[index].check = true;
                else array[index].check = false;
            }
        }

        function convertVeevaMdlToDependencyExtension(mdlFileName) {
            return mdlFileName.replace(new RegExp('.mdl$'), '.dep');
        }

        // disable any action on click 'Enter' button.
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
            }
        });
    </script>
</apex:page>