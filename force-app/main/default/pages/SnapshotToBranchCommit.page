              var selectedCompMap = {};

              $scope.updateMetaData = function () {
                  // console.log('fileMap:'+JSON.stringify(fileMap));
                  // console.log('allCompMap:'+JSON.stringify(allCompMap));
                  //  console.log('auraFileMap:'+JSON.stringify(auraFileMap));
                  //  console.log('$scope.initialSelectionSet0:'+$scope.initialSelectionSet0.length + 'items');
                  selectedCompMap = {};
                  var metaCrcMap = {};
                  var isFound = false;
                  const fileMapKeys = fileMap ? Object.keys(fileMap) : [];
                  for (var i = 0; i < $scope.initialSelectionSet0.length; i++) {
                      var id = $scope.initialSelectionSet0[i];
                      if (allCompMap[id] != undefined) {
                          var meta = allCompMap[id];
                          var API_Name = meta.compName;
                          var File_Name = meta.fileName;
                          var MetaType = meta.compType;
                          var metId = meta.id;

                          var key = '';
                          if (childMap[MetaType] == undefined) {
                              if (folderMap[MetaType] != undefined) {
                                  key = folderMap[MetaType] + '#' + File_Name;
                              } else {
                                  key = MetaType + '#' + File_Name;
                              }
                          } else {
                              key = MetaType + '#' + API_Name;
                          }
                          if (MetaType === 'EmailTemplate' || MetaType === 'EmailFolder') {
                              if (fileMap[key] === undefined) {
                                  const tempMetaType = 'EmailTemplate';
                                  const tempFileName = File_Name.replace('email/', '');
                                  const emailKey = fileMapKeys.find(
                                    (mapKey) => mapKey && mapKey.endsWith(tempFileName) && mapKey.startsWith(`${tempMetaType}#email/`)
                                  );
                                  fileMap[key] = fileMap[emailKey];
                                  if (MetaType === 'EmailTemplate') {
                                      fileMap[key + '-meta.xml'] = fileMap[emailKey + '-meta.xml'];
                                  }
                              }
                          }
                          if (fileMap[key] != undefined && metId != undefined) {
                              var tempMeta = new Object();
                              tempMeta.Id = metId;
                              tempMeta.crc32 = fileMap[key].crc32;
                              tempMeta.MetaType = MetaType;
                              tempMeta.API_Name = API_Name;
                              tempMeta.File_Name = File_Name;
                              tempMeta.key = key;

                              if (meta.vlocityCompName) {
                                  tempMeta.vlocityCompName = meta.vlocityCompName;
                              }

                              if (fileMap[key + '-meta.xml'] != undefined) {
                                  tempMeta.crc32 = tempMeta.crc32 + ' ' + fileMap[key + '-meta.xml'].crc32;
                              }

                              if (isVeevaCommit) {
                                  const dependencyKey = convertVeevaMdlToDependencyExtension(key);

                                  const mapCrc32 = {};
                                  mapCrc32[tempMeta.key] = tempMeta.crc32;

                                  if (fileMap[dependencyKey]) {
                                      mapCrc32[dependencyKey] = fileMap[dependencyKey].crc32;
                                  }

                                  tempMeta.crc32 = composeBundleCrc(mapCrc32);
                              }

                              metaCrcMap[metId] = tempMeta.crc32;
                              metaFoundMap[metId] = tempMeta;
                              meta.crc32 = tempMeta.crc32;
                              selectedCompMap[metId] = meta;
                              isFound = true;
                          } else if (bundleTypes.includes(MetaType) || (vlocityTypes.includes(MetaType) && isVlocityCommit)) {
                              var bundleArr = [];
                              var tempMeta = new Object();
                              tempMeta.Id = metId;
                              tempMeta.crc32 = '';
                              tempMeta.MetaType = MetaType;
                              tempMeta.API_Name = API_Name;
                              tempMeta.File_Name = File_Name;
                              tempMeta.key = key;
                              if (meta.vlocityCompName) {
                                  tempMeta.vlocityCompName = meta.vlocityCompName;
                              }
                              var map32 = {};

                              let isInSubItems = false;
                              let isAuraFileMap = auraFileMap[File_Name] !== undefined;

                              if (meta.subItemList && meta.subItemList.length) {
                                  isInSubItems = meta.subItemList
                                    .map((subItem) => subItem.slice(0, subItem.lastIndexOf('/')))
                                    .some((item) => {
                                        const isSubItem = !!auraFileMap[`${File_Name}/${item}`];
                                        if (isSubItem) {
                                            auraFileMap[File_Name] = auraFileMap[`${File_Name}/${item}`];
                                        }
                                        return isSubItem;
                                    });
                              }

                              if (isAuraFileMap || isInSubItems) {
                                  var auraMap = auraFileMap[File_Name];
                                  for (var fName in auraMap) {
                                      var descriptor = {};
                                      descriptor.fileName = fName;
                                      descriptor.crc32 = auraMap[fName].crc32;
                                      bundleArr.push(descriptor);
                                      map32[fName] = descriptor.crc32;
                                      isFound = true;
                                  }
                              }
                              if (bundleArr.length > 0) {
                                  tempMeta.crc32 = composeBundleCrc(map32);
                              }
                              metaCrcMap[metId] = tempMeta.crc32;
                              metaFoundMap[metId] = tempMeta;
                              meta.crc32 = tempMeta.crc32;
                              selectedCompMap[metId] = meta;
                          } else if (CTP_subFolderTypeMap[MetaType] != undefined) {
                              var tempFileName = '';
                              if (CTP_subFolderTypeMap[MetaType] == 'Dashboard' || CTP_subFolderTypeMap[MetaType] == 'DashboardFolder')
                                  tempFileName = File_Name.replace('dashboards/', '');
                              else if (CTP_subFolderTypeMap[MetaType] == 'Report' || CTP_subFolderTypeMap[MetaType] == 'ReportFolder')
                                  tempFileName = File_Name.replace('reports/', '');
                              else if (
                                CTP_subFolderTypeMap[MetaType] == 'EmailFolder' ||
                                CTP_subFolderTypeMap[MetaType] == 'EmailTemplate' ||
                                CTP_subFolderTypeMap[MetaType] == 'EmailTemplateFolder'
                              )
                                  tempFileName = File_Name.replace('email/', '');

                              var parentFolderName = '';
                              if (CTP_subFolderTypeMap[MetaType] == 'Dashboard' || CTP_subFolderTypeMap[MetaType] == 'DashboardFolder')
                                  parentFolderName = 'dashboards/';
                              else if (CTP_subFolderTypeMap[MetaType] == 'Report' || CTP_subFolderTypeMap[MetaType] == 'ReportFolder')
                                  parentFolderName = 'reports/';
                              else if (
                                CTP_subFolderTypeMap[MetaType] == 'EmailFolder' ||
                                CTP_subFolderTypeMap[MetaType] == 'EmailTemplate' ||
                                CTP_subFolderTypeMap[MetaType] == 'EmailTemplateFolder'
                              )
                                  parentFolderName = 'reports/';

                              var startsWithString = (folderMap[MetaType] != undefined ? folderMap[MetaType] : MetaType) + '#';

                              for (var mapKey in fileMap) {
                                  if (mapKey != undefined) {
                                      if (mapKey.endsWith(tempFileName) && mapKey.startsWith(startsWithString + '' + parentFolderName)) {
                                          var fileZip = new JSZip();
                                          var tempMeta = new Object();
                                          tempMeta.Id = metId;
                                          tempMeta.crc32 = fileMap[mapKey].crc32;
                                          tempMeta.MetaType = MetaType;
                                          tempMeta.API_Name = API_Name;
                                          tempMeta.File_Name = File_Name;
                                          tempMeta.key = key;
                                          if (meta.vlocityCompName) {
                                              tempMeta.vlocityCompName = meta.vlocityCompName;
                                          }
                                          fileZip.file(File_Name, fileMap[mapKey].data, { binary: false });
                                          tempMeta.data = fileZip.generate({ type: 'base64', compression: 'DEFLATE' });

                                          metaCrcMap[metId] = tempMeta.crc32;
                                          metaFoundMap[metId] = tempMeta;
                                          meta.crc32 = tempMeta.crc32;
                                          selectedCompMap[metId] = meta;
                                          break;
                                      }
                                  }
                              }
                          }
                      }
                  }

                  // comment this in production
                  //getSizeObject1level('metaCrcMap', metaCrcMap);
                  //getSizeObject2level('metaFoundMap', metaFoundMap);
                  //getSizeObject2level('fileMap', fileMap);
                  //getSizeObject2level('auraFileMap', metaCrcMap);
                  //getSizeObject2level('allCompMap', fileMap);

                  //console.log('metaFoundMap:'+JSON.stringify(metaFoundMap));
                  //console.log('metaCrcMap:'+JSON.stringify(metaCrcMap));
                  //console.log('selectedCompMap:'+JSON.stringify(selectedCompMap));

                  $scope.compareMetaData(metaCrcMap);
                  allCompMap = {}; // free memory
                  $scope.componentListPtr = [];
              };

              function getSizeObject1level(name, obj) {
                  var keys = [];
                  if (obj != undefined) {
                      keys = Object.keys(obj);
                  }
                  ///console.log(name+':'+keys.length + 'keys');
              }

              function getSizeObject2level(name, obj) {
                  var keys = [];
                  var size = 0;
                  if (obj != undefined) {
                      keys = Object.keys(obj);
                  }
                  ////////console.log('keys:'+JSON.stringify(keys));
                  for (var x = 0; x < keys.length; x++) {
                      var key = keys[x];
                      var o = obj[key];
                      if (o != undefined) {
                          size += JSON.stringify(o).length;
                      }
                  }
                  ///console.log(name+':'+keys.length + 'keys');
                  ///console.log('size:'+size + 'bytes');
                  ///console.log('============');
              }

              $scope.compareMetaData = function (metaCrcMap) {
                  //////console.log('compareMetaData:');
                  // split all set into blocks by 4000
                  var blocks = [];
                  var first = 0;
                  var end = BLOCKSIZE;
                  var len = $scope.initialSelectionSet0.length;
                  ////////console.log('sel:'+JSON.stringify($scope.initialSelectionSet0));
                  while (first < len) {
                      if (end > len) {
                          end = len;
                      }
                      var block = new Object();
                      block.metaIdList = $scope.initialSelectionSet0.slice(first, end); // get slice of array
                      block.crcMap = getSubMap(block.metaIdList); // get submap of map
                      blocks.push(block);
                      first = end;
                      end += BLOCKSIZE;
                  }
                  ////console.log('formed '+blocks.length + ' blocks');
                  for (var x = 0; x < blocks.length; x++) {
                      ////console.log('block['+x +']:'+blocks[x].metaIdList.length + ' items');
                  }

                  $scope.isLoading = true;

                  $scope.compareData(blocks, function () {
                      //////console.log('load for compareData finished');
                      $scope.isLoading = false;
                      clearMessage();
                      hide();
                      ////console.log('new:'+$scope.newCompList.length);
                      ////console.log('with conflicts:'+$scope.componentList.length);
                      ////console.log('not to commit:'+$scope.notMergeCompList.length);
                  });

                  function getSubMap(list) {
                      var crcMap = {};
                      if (list != undefined && list.length > 0) {
                          for (var x = 0; x < list.length; x++) {
                              crcMap[list[x]] = metaCrcMap[list[x]];
                          }
                      }
                      return crcMap;
                  }
              };

              /************************           Init section                ****************************/

              // init the variables for controller
              $scope.initialize = function () {
                  $scope.attIdMap = {};
                  $scope.globalAttIdMap = {};
                  $scope.componentBaseList = [];
                  $scope.componentListPtr = [];
                  $scope.typeFilter = 'all';
                  $scope.searchText = '';
                  var element = document.getElementById('pg:fullform:FirstPageBlock:pbs1:pbsi1:picklst1');
                  if (element != undefined) {
                      element.value = 'all';
                  }

                  if ($scope.isLoading == false) {
                      setMessageOnPage('Loading Data...');
                      $scope.isLoading = true;

                      dataManager.getAllItems().then(
                        function (data) {
                            if (data != null && data != undefined && data.length > 0) {
                                ////console.log('got items:'+data.length);
                                // split all data in blocks
                                var blocks = [];
                                var first = 0;
                                var end = 10000;
                                while (first < data.length) {
                                    if (end > data.length) {
                                        end = data.length;
                                    }
                                    blocks.push(data.slice(first, end));
                                    first = end;
                                    end += 10000;
                                }
                                $scope.loadData(blocks, function () {
                                    //////console.log('load finished');
                                    $scope.isLoading = false;
                                    correctDate($scope.componentBaseList);
                                    setAll($scope.componentBaseList, false);
                                    $scope.applyFilter();
                                    clearMessage();
                                });
                            } else {
                                setMessageOnPage('Nothing to commit');
                            }
                        },
                        function (error) {
                            showErrorMessage('Error:' + error);
                            $scope.isLoading = false;
                        }
                      );
                  }
              };
              $scope.initialize();

              $scope.applyFilter = function () {
                  if ($scope.typeFilter == 'all') {
                      var lst = [];
                      for (var x = 0; x < $scope.componentBaseList.length; x++) {
                          lst.push($scope.componentBaseList[x]);
                      }
                      $scope.componentListPtr = lst;
                  } else if ($scope.typeFilter != '' && $scope.typeFilter != undefined) {
                      var lst = [];
                      for (var x = 0; x < $scope.componentBaseList.length; x++) {
                          var elem = $scope.componentBaseList[x];
                          if (elem.compType == $scope.typeFilter) {
                              lst.push(elem);
                          }
                      }
                      $scope.componentListPtr = lst;
                  }
                  ////////console.log('size:'+lst.length);
                  $scope.$apply();
              };

              /*************************** New Merge Section   ****************************************/
              /******             PopUp methods           ******/

              function isEditable(fileName) {
                  if (fileName === undefined) return false;
                  let n = fileName.lastIndexOf('.');
                  if (n < 0) return false;
                  let ext = fileName.substr(n);
                  return EDITABLE_EXT.includes(ext);
              }

              function formatDetail(data) {
                  if (data == undefined || data == '') {
                      return ' N/A';
                  }
                  return ' ' + data;
              }

              $scope.disableContinueButton = function () {
                  $timeout(function () {
                      $scope.continueButton = true;
                  });
              };

              $scope.enableContinueButton = function () {
                  $timeout(function () {
                      $scope.continueButton = false;
                  });
              };

              // edit aura bundle component
              $scope.openPopUpInfo = function (param) {
                  setMessageOnPage('Loading Data...');
                  //$j('#spinner').css('display','initial');
                  show();
                  if (!ArchiveService.inStack(param.id)) {
                      $scope.loadComponent(param);
                      return;
                  }
                  $scope.PopUpInfo = {
                      bundleTitle: param.compName,
                      compName: param.compName,
                      compType: param.compType,
                      snapName: 'Snapshot ' + snapshotName + '(This component will be saved in the target branch)',
                      branchName: 'Branch ' + param.branchName,
                  };
                  $scope.targetDetailsBundle =
                    'changed by' + formatDetail(param.tgtChangedBy) + ' on' + formatDetail(param.tgtChangedOnTxt);
                  $scope.sourceDetailsBundle =
                    'changed by' + formatDetail(param.changedBy) + ' on' + formatDetail(param.changedOnTxt);
                  $scope.PopUpInfo.Info = param;
                  // create a backup of zip with aura bundle before work - when the cancel btn will be clicked, zip file left untouched
                  if (ArchiveService.inStack(param.id)) {
                      CacheService.push('BACKUP' + param.id, ArchiveService.getZipDescription(param.id)[1]);
                  }

                  if (CacheService.isCached(param.id)) {
                      CacheService.pop(param.id, function (data) {
                          $scope.bundleList = data.bundleList;
                          bundleComponentStack = data.bundleComponentStack;
                      });
                  } else {
                      //not possible to restore from cache
                      $scope.bundleList = [];

                      var bundles = ArchiveService.getZipDescription(param.id);
                      var srcMap;
                      var srcMapMerged = null;

                      srcMap = bundles[0];
                      var tgtMap = bundles[1];
                      var index = 0; // counter which is = uid in bundleComponentStack
                      // clear bundle stack from previous components
                      bundleComponentStack = [];
                      // form bundleComponentStack from retrieved data with UID = index of bundle elements, use this UID for access a descriptor

                      for (var key in srcMap) {
                          if (srcMap.hasOwnProperty(key)) {
                              var row = {};
                              var srcDescriptor,
                                tgtDescriptor = null,
                                descriptor;
                              //establish the descriptor
                              row.srcCompName = key;
                              srcDescriptor = srcMap[key];

                              var srcDescrMerged = null;
                              if (srcMapMerged != null && srcMapMerged.hasOwnProperty(key)) {
                                  srcDescrMerged = srcMapMerged[key];
                              }

                              descriptor = srcDescriptor;
                              if (tgtMap.hasOwnProperty(key)) {
                                  row.tgtCompName = key;
                                  tgtDescriptor = tgtMap[key];
                                  if (descriptor != undefined) {
                                      descriptor.target = tgtDescriptor.target; //update target file if pair (the only difference)
                                  } else {
                                      descriptor = tgtDescriptor; //never executed
                                  }
                              }
                              descriptor.isManualMerge = false;
                              //establish the record

                              if (srcDescrMerged != null && srcDescrMerged.mergeFile) {
                                  row.source = srcDescrMerged.mergeFile;
                                  descriptor.mergeFile = srcDescrMerged.mergeFile;
                              }
                              row.uid = index;
                              row.id = param.id;
                              row.fileName = descriptor.fileName;
                              row.fullName = key;
                              row.compName = param.compName;
                              row.compType = param.compType;
                              row.isEditable = isEditable(row.fileName); // can be edited, if ext in file allows that
                              row.changedBy = param.changedBy;
                              row.branchName = param.branchName;
                              row.tgtChangedBy = param.tgtChangedBy;
                              row.changedOnTxt = param.changedOnTxt;
                              row.tgtChangedOnTxt = param.tgtChangedOnTxt;
                              if (srcDescriptor != undefined && tgtDescriptor != undefined) {
                                  // part of Aura with name compName exists in both containers
                                  if (srcDescrMerged != null && srcDescrMerged.mergeFile) {
                                      if (srcDescrMerged.mergeFile === tgtDescriptor.target) {
                                          //they are equals
                                          row.conflictCode = 0;
                                          row.isConflict = false;
                                          descriptor.isManualMerge = true;
                                      } else {
                                          if (param.changedBy == param.tgtChangedBy) {
                                              row.conflictCode = -1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = false;
                                          } else {
                                              row.conflictCode = 1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = true;
                                          }
                                      }
                                  } else {
                                      if (srcDescriptor.source === tgtDescriptor.target) {
                                          //they are equals
                                          row.conflictCode = 0;
                                          row.isConflict = false;
                                          descriptor.isManualMerge = true;
                                      } else {
                                          if (param.isAutoResolved == true) {
                                              row.conflictCode = -1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = false;
                                          } else {
                                              row.conflictCode = 1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = true;
                                          }
                                      }
                                  }
                              } else if (srcDescriptor != undefined && tgtDescriptor == undefined) {
                                  row.conflictCode = 4; // deleted part of composite component (Aura, Static)
                                  row.isConflict = false;
                                  row.moved = false; // initial value is always false
                              } // left code = 1, if no block execs
                              // check case conflictCode = 5 :  isConflict && !isEditable
                              if (row.isEditable == false && row.isConflict == true) {
                                  // set autoresolved with ability to replace component from the target
                                  row.conflictCode = 5;
                                  row.isConflict = false;
                              }

                              if (descriptor != undefined) {
                                  $scope.bundleList.push(row);
                                  bundleComponentStack.push(descriptor);
                                  index++; // index plays role of UID
                              }
                          }
                      }

                      for (var key in tgtMap) {
                          // add keys which are not present in srcMap
                          if (tgtMap.hasOwnProperty(key)) {
                              var row = {};
                              var descriptor;
                              if (!srcMap.hasOwnProperty(key)) {
                                  descriptor = tgtMap[key];
                                  descriptor.isManualMerge = false;

                                  var srcDescrMerged = null;
                                  if (srcMapMerged != null && srcMapMerged.hasOwnProperty(key)) {
                                      srcDescrMerged = srcMapMerged[key];
                                  }
                                  if (srcDescrMerged != null && srcDescrMerged.mergeFile) {
                                      row.source = srcDescrMerged.mergeFile;
                                      descriptor.mergeFile = srcDescrMerged.mergeFile;
                                      descriptor.source = srcDescrMerged.mergeFile;
                                      if (srcDescrMerged.mergeFile === descriptor.target) {
                                          //they are equals
                                          row.conflictCode = 0;
                                          row.isConflict = false;
                                          descriptor.isManualMerge = true;
                                      } else {
                                          if (param.changedBy == param.tgtChangedBy) {
                                              row.conflictCode = -1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = false;
                                          } else {
                                              row.conflictCode = 1; // 0 - equals, 1 - conflict, 2 - merged, 3 - new, 4 -deleted, 5 - replaced from target
                                              row.isConflict = true;
                                          }
                                      }
                                  } else {
                                      descriptor.source = '';
                                      row.conflictCode = 3; // added part of composite component (Aura, Static)
                                      row.isEditable = false; // only move/remove possible - always
                                      row.isConflict = false;
                                      row.moved = false; // initial value is always false
                                  }

                                  row.tgtCompName = key;
                                  row.uid = index;
                                  row.id = param.id;
                                  row.fileName = descriptor.fileName;
                                  row.fullName = key;
                                  row.branchName = param.branchName;
                                  row.compName = param.compName;
                                  row.compType = param.compType;
                                  row.changedBy = param.changedBy;
                                  row.tgtChangedBy = param.tgtChangedBy;
                                  row.changedOnTxt = param.changedOnTxt;
                                  row.tgtChangedOnTxt = param.tgtChangedOnTxt;
                                  if (descriptor != undefined) {
                                      $scope.bundleList.push(row);
                                      bundleComponentStack.push(descriptor);
                                      index++; // index plays role of UID
                                  }
                              }
                          }
                      }
                  }
                  delete bundles;

                  $scope.PopUpInfo.closeBundleManualMerge = function () {
                      var backUpKey = 'BACKUP' + param.id;
                      if (CacheService.isCached(backUpKey)) {
                          CacheService.pop(backUpKey, function (data) {
                              ArchiveService.updateTargetZip(param.id, data);
                              param.isManualMerge = false;
                          });
                      }
                      $scope.EditBundle = false;
                      $scope.CommitStep = 1;
                      delete $scope.PopUpInfo;
                      hide();
                      $scope.enableContinueButton();
                  };

                  $scope.PopUpInfo.bundleManualMerge = function (next) {
                      // update original component - ( param)
                      // verify IsManualMerge flags for all  bundle Components
                      if ($scope.bundleList != undefined) {
                          for (var i = 0; i < $scope.bundleList.length; i++) {
                              if ($scope.bundleList[i].isConflict) {
                                  //set error message
                                  $j('.bundle_error_msg').fadeIn().delay(5000).fadeOut();
                                  return;
                              }
                          }
                          //no conflicts, merge passed
                      }

                      var comp = $scope.PopUpInfo.Info;

                      ArchiveService.setMergeFiles(param, $scope.bundleList);

                      param.isConflict = false;
                      param.status = RESOLVED;
                      param.isManualMerge = true;
                      param.lastCompare = Date.now();
                      $scope.EditBundle = false;

                      param.compare = RESOLVED;
                      $scope.CommitStep = 1;

                      var archive = {};
                      archive.bundleComponentStack = bundleComponentStack;
                      archive.bundleList = $scope.bundleList;
                      CacheService.push(param.id, archive);
                      hide();
                      $scope.enableContinueButton();
                  };

                  $scope.EditBundle = true;
                  $scope.CommitStep = 4;
                  hide();
                  clearMessage();
                  $scope.disableContinueButton();
              };

              /**
               *  Define the class to edit a general component of any elemental type
               */
              $scope.getMergeInfo = function (param) {
                  if (isVeevaCommit) {
                      $scope.openComparison(param);
                      return;
                  }
                  snapName = 'Snapshot ' + snapshotName + '  (This component will be saved in the target branch)';
                  $scope.targetDetails =
                    'Branch ' +
                    param.branchName +
                    '###' +
                    'changed by' +
                    formatDetail(param.tgtChangedBy) +
                    ' on' +
                    formatDetail(param.tgtChangedOnTxt);
                  $scope.sourceDetails =
                    snapName + '###' + 'changed by' + formatDetail(param.changedBy) + ' on' + formatDetail(param.changedOnTxt);

                  if (isBundle(param.compType, param.fileName) == true && !$scope.EditBundle) {
                      $scope.openPopUpInfo(param);
                      return;
                  }

                  if (param.isMetaConflict == true && !$scope.EditBundle) {
                      $scope.openPopUpInfo(param);
                      return;
                  }

                  if (!ArchiveService.inStack(param.id)) {
                      console.log('load components');
                      $scope.loadComponent(param);
                      return;
                  }

                  if (isBundle(param.compType, param.fileName) == false && param.isMetaConflict == false) {
                      var MergeInfo = ArchiveService.getZipDescription(param.id); // get descriptor for edited component
                      var compId = param.id;
                  } else {
                      //      use alternative stack if aura component
                      var MergeInfo = bundleComponentStack[param.uid];
                      var compId = param.uid;
                  }
                  var component = param;

                  if (MergeInfo != undefined) {
                      itemType = MergeInfo.IsXML ? 'XML' : 'TEXT';
                      $scope.PopUp = {}; // its an object to hold info about edited component
                      $scope.PopUp.title = param.compType + ' : ' + param.compName;
                      $scope.PopUp.compName = param.compName;
                      $scope.PopUp.compType = param.compType;

                      $scope.PopUp.base = MergeInfo.source ? MergeInfo.source : '';
                      $scope.PopUp.newfile = MergeInfo.mergeFile ? MergeInfo.mergeFile : MergeInfo.target;

                      $scope.PopUp.EtalonValue = '';
                      $scope.PopUp.BackUp = MergeInfo.bkUp;
                      $scope.PopUp.ItemId = compId;
                      $scope.PopUp.isXml = MergeInfo.IsXML;

                      openMergeEditor($scope.PopUp);

                      $scope.PopUp.ManualMerge = function (txt, next) {
                          ArchiveService.setMergeFile(compId, txt);

                          $timeout(function () {
                              component.isConflict = false;
                              component.isManualMerge = true;

                              component.status = RESOLVED;
                              component.lastCompare = Date.now();
                              if ($scope.EditBundle) param.conflictCode = 2;
                              if ($scope.EditBundle) {
                                  component.compare = RESOLVED;
                                  $scope.CommitStep = 4;
                              } else {
                                  component.compare = RESOLVED;
                                  $scope.CommitStep = 1;
                              }
                          });
                      };
                      $scope.PopUp.ManualMergeXml = function (xml, next, xmlBk) {
                          ArchiveService.setMergeFile(compId, xml);
                          ArchiveService.setBkUp(compId, xmlBk);

                          $timeout(function () {
                              component.isConflict = false;
                              component.isManualMerge = true;

                              component.status = RESOLVED;
                              component.lastCompare = Date.now();
                              if ($scope.EditBundle) param.conflictCode = 2;
                              if ($scope.EditBundle) {
                                  component.compare = RESOLVED;
                                  $scope.CommitStep = 4;
                              } else {
                                  component.compare = RESOLVED;
                                  $scope.CommitStep = 1;
                              }
                              //$scope.CommitStep = $scope.EditBundle?4:0;
                              $scope.dataProcessing = false;
                              delete param;
                          });
                      };

                      $scope.PopUp.closeManualMerge = function () {
                          $scope.CommitStep = $scope.EditBundle ? 4 : 1;
                          delete param;
                          delete $scope.PopUp;
                      };
                      $scope.PopUp.closeManualMergeXml = function (xmlBk) {
                          $scope.CommitStep = $scope.EditBundle ? 4 : 1;
                          setBkUp(compId, xmlBk);
                          $scope.dataProcessing = false;
                          delete param;
                          delete $scope.PopUp;
                      };
                  }

                  function openMergeEditor(o) {
                      var windowWidth = screen.availWidth;
                      var windowHeight = screen.availHeight;
                      var editorPageUrl = '{!JSENCODE(editMetaDataPageName)}';
                      var link = editorPageUrl;
                      var obj = {};
                      obj.type = o.compType;
                      obj.name = o.compName;
                      obj.mode = o.isXml == true ? 'XML' : 'TXT';
                      if (o.newfile != undefined) {
                          obj.tgt = pako.deflate(o.newfile, { to: 'string' });
                      } else {
                          obj.tgt = '';
                      }
                      if (o.base != undefined) {
                          obj.src = pako.deflate(o.base, { to: 'string' });
                      } else {
                          obj.src = '';
                      }

                      obj.rightTitle = $scope.targetDetails;
                      obj.leftTitle = $scope.sourceDetails;

                      obj.saveAndNext = false;
                      // set dimensions for popup, both inner and outer
                      obj.width = windowWidth < 600 ? 600 : windowWidth - 150;
                      obj.height = windowHeight < 500 ? 500 : windowHeight - 270;
                      var popupParams =
                        'width=' + (obj.width + 150) + ',height=' + (obj.height + 270) + ',fullscreen=1,resizable=1,scrollbars=1';

                      $j('body').data('userData', obj);

                      var windowTitle = o.compType + ' ' + o.compName;
                      //console.log('link='+link);
                      //console.log('popupParams='+popupParams);
                      var w = window.open(link, 'RW', popupParams);
                      setTitle(w, windowTitle);
                  }

                  clearMessage();
                  //debug('step:'+$scope.CommitStep);
              };

              // this function load raw data tied with specific component, then add it to  components stack
              $scope.loadComponent = function (item) {
                  if (item != undefined && item.conflict != undefined) {
                      dataManager.getAttachments(item.conflict).then(
                        function (data) {
                            if (data != undefined && data.length == 1) {
                                // extract files from zip
                                let zipStr0 = data[0].base64;
                                if (isBundle(item.compType, item.fileName) == true && item.compType != 'StaticResource') {
                                    let auraContext = auraFileMap[item.fileName];
                                    if (item.compType == 'ExperienceBundle') {
                                        let key = item.fileName.slice(0, item.fileName.lastIndexOf('/'));
                                        let expMap = auraFileMap[key];
                                        if (expMap != undefined && expMap[item.fileName + '.site-meta.xml'] != undefined) {
                                            auraContext[item.fileName + '.site-meta.xml'] = expMap[item.fileName + '.site-meta.xml'];
                                        }
                                    }
                                    ArchiveService.addZips(zipStr0, auraContext, item).then(() => $scope.openPopUpInfo(item));
                                } else if (item.compType == 'StaticResource') {
                                    let context = fileMap[metaFoundMap[item.id].key]?.data;
                                    let meta = fileMap[metaFoundMap[item.id].key + '-meta.xml']?.data;
                                    let attZip = new JSZip();
                                    attZip.file(item.fileName, context, { binary: true }); // put zip inside zip
                                    attZip.file(item.fileName + '-meta.xml', meta, { binary: true }); // put zip inside zip
                                    let base64 = attZip.generate({ type: 'base64', compression: 'DEFLATE' });
                                    ArchiveService.addZips(zipStr0, base64, item).then(() => $scope.openPopUpInfo(item));
                                } else if (item.isMetaConflict == true) {
                                    let context = {};
                                    context[item.fileName] = fileMap[metaFoundMap[item.id].key]?.data;
                                    context[item.fileName + '-meta.xml'] = fileMap[metaFoundMap[item.id].key + '-meta.xml']?.data;
                                    ArchiveService.addZips(zipStr0, context, item).then(() => $scope.openPopUpInfo(item));
                                } else {
                                    let context = fileMap[metaFoundMap[item.id].key]?.data;
                                    if (item.compType == 'Profile' || item.compType == 'PermissionSet') {
                                        context = unpack(context, true);
                                    }
                                    ArchiveService.addZips(zipStr0, context, item).then(() => $scope.getMergeInfo(item));
                                }
                            } else {
                                hide();
                                clearMessage();
                                showErrorMessage(
                                  'Branch merging encountered a problem due to a corrupted component. Error retrieving attachments for ' +
                                  item.compName
                                );
                            }
                        },
                        function (error) {
                            hide();
                            clearMessage();
                            showErrorMessage(error);
                        }
                      );
                  } else {
                      hide();
                      clearMessage();
                      showErrorMessage('Branch merging encountered a problem due to a corrupted component.');
                  }
              };

              function setTitle(w, title) {
                  if (w) {
                      w.onload = function () {
                          setTimeout(function () {
                              w.document
                                .getElementsByTagName('head')[0]
                                .appendChild(document.createElement('title'))
                                .appendChild(document.createTextNode(title));
                          }, 5);
                      };
                  }
              }
              $scope.updateBundle = function (item) {
                  item.moved = !item.moved;
              };
              /*************************** End New Merge Section   ****************************************/
          }
        );

        const EDITABLE = {
            'application/javascript': true,
            'text/css': true,
            'text/plain': true
        };

        const EDITABLE_EXT = JSON.parse('{!JSENCODE(editableExtListJSON)}');

        String.prototype.isXml = function () {
            return this.substr(0, 10).indexOf('<?xml') > -1 ? true : false;
        };

        function callBackText(updated) {
            var s = getScope();
            var merged = pako.inflate(updated.data, { to: 'string' });
            if (updated.isXml == true) {
                s.PopUp.ManualMergeXml(merged, updated.next);
            } else {
                s.PopUp.ManualMerge(merged, updated.next);
            }
        }

        function isBundle(type, fileName) {
            if (fileName !== undefined && type == 'OmniScript' && fileName.indexOf('omniScripts/') > -1) {
                return false;
            }
            return bundleTypesSet.has(type) || type == 'StaticResource' || vlocityTypes.includes(type) || isVeevaCommit;
        }

        function updateCRC32(Item, newCRC32) {
            if (typesWithMeta[Item.compType]) {
                // detect which part is edited, and update only this
                if (Item.crc32 != undefined && Item.crc32 != '') {
                    var crc32 = '' + Item.crc32;
                    var crcArray = crc32.split(' ');
                    if (crcArray.length == 2) {
                        if (Item.compType.indexOf('(meta)') > -1) {
                            // update only 2nd part
                            Item.crc32 = crcArray[0] + ' ' + newCRC32;
                        } else {
                            Item.crc32 = newCRC32 + ' ' + crcArray[1];
                        }
                        return;
                    }
                }
                Item.crc32 = newCRC32;
            } else {
                Item.crc32 = newCRC32;
            }
        }

        function updateCRC32Meta(Item, newCRC32) {
            Item.crc32 = newCRC32;
        }

        var zipMap = {};
        var componentStack = {};

        myApp.factory('ArchiveService', function ($q) {
            componentStack = {}; // detail info about merged component
            zipMap = {}; // map attId=>attachment
            var counter = 0; // number of saved attachments
            var mapCrc32 = {};
            var readZipMap = [];
            var resultMapCRC32 = {};

            function readZip(zipBase, index, comp) {
                return new Promise(function (resolve, reject) {
                    let resultMap = {};
                    let zip = new JSZip(zipBase, { base64: true });
                    const isVlocity = vlocityTypes.includes(comp.compType) && isVlocityCommit;
                    let isInnerZip = false;
                    if (comp.compType == 'StaticResource') {
                        isInnerZip = isInnerZipContains(zip);
                    }
                    if (bundleTypes.includes(comp.compType) || isVlocity) {
                        // process aura components
                        for (let fileName in zip.files) {
                            if (zip.files[fileName].dir == false) {
                                let name = getAuraName(fileName, comp.compType);
                                if (name == undefined) continue;
                                let fileData = zip.files[fileName].asText();
                                const crcWithData = getCrcWithData(fileData);
                                resultMap[fileName] = crcWithData.data;
                                resultMapCRC32[index + '#' + fileName] = crcWithData.crc32;
                            }
                        }
                    } else {
                        for (let fileName in zip.files) {
                            if (
                              fileName != undefined &&
                              fileName.charAt(fileName.length - 1) != '/' &&
                              fileName != 'package.xml' &&
                              fileName != 'undefined' &&
                              zip.files[fileName].dir == false
                            ) {

                                if (isInnerZip && !fileName.endsWith('.resource-meta.xml')) {
                                    let fileData = zip.files[fileName].asBinary();
                                    const crcWithData = getCrcWithData(fileData, { isInnerZip: true });
                                    resultMap[fileName] = crcWithData.data;
                                    resultMapCRC32[index + '#' + fileName] = crcWithData.crc32;
                                } else {
                                    let fileData = zip.files[fileName].asText();
                                    const crcWithData = getCrcWithData(fileData);
                                    resultMap[fileName] = crcWithData.data;
                                    resultMapCRC32[index + '#' + fileName] = crcWithData.crc32;
                                }
                            }
                        }
                    }
                    readZipMap[index] = resultMap;
                    resolve(resultMap);
                });
            }

            function extractFile(zip1, context, comp) {
                return new Promise(function (resolve, reject) {
                    var tempSrcZip, tempTgtZip;
                    readZipMap = [];
                    resultMapCRC32 = {};
                    let allPromises = [];
                    let snapComp = {};
                    snapComp[comp.fileName] = context;
                    allPromises.push(
                      new Promise((res) => {
                          res(readZip(zip1, 'source', comp));
                      })
                    );
                    Promise.all(allPromises).then(function () {
                        zipMap[comp.id] = zip1;
                        tempSrcZip = readZipMap['source'];

                        if (isBundle(comp.compType, comp.fileName) == false && comp.isMetaConflict == false) {
                            tempTgtZip = snapComp;
                            let descriptor = {};
                            descriptor.id = comp.id; // set Attachment's ID which later will be used for update
                            descriptor.compType = comp.compType;
                            descriptor.compName = comp.compName;
                            descriptor.fileName = comp.fileName; // extract only file specified in fileName field
                            descriptor.length = zipMap[comp.id].length;
                            descriptor.crc32 = comp.crc32;
                            descriptor.mime = isEditable(comp.fileName); //detect type of extracted file
                            try {
                                if (tempSrcZip[comp.fileName] != null) {
                                    descriptor.source = tempSrcZip[comp.fileName];
                                } else {
                                    descriptor.source = '';
                                }
                                if (tempTgtZip[comp.fileName] != null) {
                                    descriptor.target = tempTgtZip[comp.fileName];
                                } else {
                                    descriptor.target = '';
                                }
                            } catch (e) {
                                console.log(e);
                            }
                            descriptor.IsXML = false;
                            if (descriptor.target != undefined && descriptor.target != '') {
                                descriptor.IsXML = descriptor.target.isXml();
                            }
                            componentStack[comp.id] = descriptor; // for non-aura return descriptor
                            resolve();
                        } else if (isBundle(comp.compType, comp.fileName) == true) {
                            //return array of descriptors for each file in AuraDefinitionBundle (in general: any dir with files)
                            let srcDescrMap;
                            let tgtDescrMap;
                            let lst = [];
                            tempTgtZip = {};

                            if (bundleTypesSet.has(comp.compType) || vlocityTypes.includes(comp.compType) || isVeevaCommit) {
                                for (let key in context) {
                                    tempTgtZip[key] = context[key].data;
                                }
                                srcDescrMap = getDescriptionMap(tempSrcZip, comp, 'source', false);
                                tgtDescrMap = getDescriptionMap(tempTgtZip, comp, 'target', false);
                                lst.push(srcDescrMap);
                                lst.push(tgtDescrMap);
                                componentStack[comp.id] = lst;
                                resolve();
                            } else {
                                // Static type
                                parseResource(comp, zip1, 'source').then(function (descrMap) {
                                    srcDescrMap = descrMap;
                                    parseResource(comp, context, 'target').then(function (descrMap) {
                                        tgtDescrMap = descrMap;
                                        lst.push(srcDescrMap);
                                        lst.push(tgtDescrMap);
                                        componentStack[comp.id] = lst;
                                        resolve();
                                    });
                                });
                            }
                        } else if (comp.isMetaConflict == true) {
                            let srcDescrMap;
                            let tgtDescrMap;
                            tempTgtZip = context;
                            srcDescrMap = getDescriptionMap(tempSrcZip, comp, 'source', false);
                            tgtDescrMap = getDescriptionMap(tempTgtZip, comp, 'target', false);
                            let lst = [];
                            lst.push(srcDescrMap);
                            lst.push(tgtDescrMap);
                            componentStack[comp.id] = lst;
                            resolve();
                        } else {
                            resolve();
                        }
                    });
                });
            }

            function parseResource(comp, rZip, type) {
                return new Promise(function (resolve, reject) {
                    let compName = 'staticresources/' + comp.compName + '.resource';
                    let metaName = compName + '-meta.xml';
                    let tgtDescrMap = {};
                    let arch = new JSZip(rZip, { base64: true });
                    if (arch.files[metaName]) {
                        // process content if and only if it contains  meta.xml file
                        let meta = arch.file(metaName).asBinary();
                        let x2js = new X2JS({ useDoubleQuotes: true, stripWhitespaces: false, escapeMode: true });
                        metaObj = x2js.xml_str2json(meta);
                        comp.contentType = metaObj.StaticResource.contentType;
                        let innerZip =
                          metaObj.StaticResource.contentType == 'application/zip' ||
                          metaObj.StaticResource.contentType == 'application/x-zip-compressed';

                        if (innerZip == true) {
                            //unpack inner zip
                            let zip1 = arch.file(compName).asBinary();
                            let rZip2 = new JSZip(zip1, { base64: false });
                            let files = Object.keys(rZip2.files).sort();
                            for (let x = 0; x < files.length; x++) {
                                let fileName = files[x];

                                if (fileName.lastIndexOf('/') == fileName.length - 1) continue; // omit paths like css/, etc
                                let descriptor = {};
                                descriptor.id = comp.id; // set Attachment's ID which later will be used for update
                                descriptor.compType = comp.compType;
                                descriptor.compName = fileName;
                                descriptor.innerZip = innerZip;
                                descriptor.fileName = fileName;
                                descriptor.length = zipMap[comp.id]?.length;
                                descriptor.mime = isEditable(fileName); //detect type of extracted file
                                if (descriptor.mime == true) {
                                    descriptor[type] = rZip2.file(fileName).asText();
                                } else {
                                    descriptor[type] = rZip2.file(fileName).asBinary();
                                }
                                if (descriptor[type] != null && descriptor[type] != '') {
                                    descriptor.IsXML = descriptor.compName.indexOf('-meta.xml') == -1 ? false : true; // set xml flag only for meta
                                    descriptor.crc32 = rZip2.crc32(descriptor[type], 32);
                                    tgtDescrMap[descriptor.fileName] = descriptor; //return not-null only if target != null
                                }
                            }

                            resolve(tgtDescrMap);
                        } else {
                            readZip(rZip, 'res', comp).then(function (res) {
                                tgtDescrMap = getDescriptionMap(res, comp, type, innerZip);
                                resolve(tgtDescrMap);
                            });
                        }
                    } else {
                        resolve(tgtDescrMap);
                    }
                });
            }

            function getDescriptionMap(zip, comp, type, displayFullName, excluded) {
                let tgtDescrMap = {};
                let files = Object.keys(zip).sort();
                for (let x = 0; x < files.length; x++) {
                    let fileName = files[x];
                    if (fileName == excluded) continue;
                    if (fileName.lastIndexOf('/') == fileName.length - 1) continue; // omit paths like css/, etc
                    let descriptor = {};
                    descriptor.id = comp.id; // set Attachment's ID which later will be used for update
                    descriptor.compType = comp.compType;
                    descriptor.compName = displayFullName == true ? fileName : comp.compName;
                    descriptor.fileName = fileName;
                    descriptor.length = zipMap[comp.id]?.length;
                    descriptor.mime = isEditable(fileName); //detect type of extracted file
                    descriptor[type] = zip[fileName];

                    if (descriptor[type] != null && descriptor[type] != '') {
                        descriptor.IsXML = descriptor.compName.indexOf('-meta.xml') == -1 ? false : true; // set xml flag only for meta
                        descriptor.crc32 = resultMapCRC32[type + '#' + fileName];
                        tgtDescrMap[descriptor.fileName] = descriptor; //return not-null only if target != null
                    }
                }
                return tgtDescrMap;
            }

            function isEditable(fName) {
                let res = false;
                if (fName != undefined && fName != '') {
                    let extPos = fName.lastIndexOf('.');
                    if (extPos > -1) {
                        let ext = fName.substr(extPos);
                        res = EDITABLE_EXT.includes(ext);
                    }
                }
                return res;
            }

            function setFile(Item, File) {
                if (File != undefined && File != '' && Item != undefined) {
                    if (Item.IsXML) {
                        let resultXML = File;
                        if (resultXML.isXml()) {
                            Item.mergeFile = resultXML;
                        } else {
                            resultXML = vkbeautify.xmlmin(resultXML, true);
                            Item.mergeFile = '<?xml version="1.0" encoding="UTF-8"?>\n' + vkbeautify.xml(resultXML);
                        }
                    } else {
                        Item.mergeFile = File;
                    }
                    Item.conflictCode = 2; // set flag indicated that new merge File in Bundle has been updated at least once
                } else if (Item != undefined) {
                    Item.mergeFile = File;
                    Item.conflictCode = 2; // set flag indicated that new merge File in Bundle has been updated at least once
                } else {
                    // nothing todo
                    console.log('nothing todo');
                    return;
                }
            }

            function persistFile(Item, tempZip) {
                let isInnerZip = false;
                if (Item.compType == 'StaticResource') {
                    isInnerZip = isInnerZipContains(tempZip);
                }

                if (Item.mergeFile != '' && Item.mergeFile != undefined) {
                    //empty file means delete operation

                    zip.createReader(
                      new zip.Data64URIReader(tempZip),
                      function (reader) {
                          var EntryIndex = 0;
                          // get all entries from the zip
                          reader.getEntries(function (entries) {
                              if (entries.length) {
                                  var readSingleFile = function () {
                                      if (EntryIndex < entries.length) {
                                          var singleEntry = entries[EntryIndex];
                                          var fileName = singleEntry.filename;
                                          if (fileName == Item.fileName) {
                                              let newCrc32;
                                              if (isInnerZip && !fileName.endsWith('.resource-meta.xml')) {
                                                  newCrc32 = getCrc(Item.mergeFile, { isInnerZip: true }).crc32;
                                              } else {
                                                  newCrc32 = getCrc(Item.mergeFile).crc32;
                                              }
                                              mapCrc32[Item.fileName] = newCrc32;
                                              updateCRC32(Item, newCrc32);
                                          }
                                          EntryIndex++;
                                          readSingleFile();
                                      } else {
                                          // close the zip reader
                                          reader.close(function () {
                                              // onclose callback
                                          });
                                      }
                                  };
                                  readSingleFile();
                              } else {
                                  showErrorMessage('Content of component not found.');
                              }
                          });
                      },
                      function (error) {
                          // onerror callback
                          console.log('Error in reading file from attachments.');
                          console.log(error);
                          console.log(JSON.stringify(error));
                          if (error.message != undefined) {
                              showErrorMessage(error.message);
                          } else {
                              showErrorMessage('Unknown error.');
                          }
                      }
                    );
                } else {
                    //TODO: verify existence
                    //tempZip.remove(Item.fileName);
                    Item.crc32 = '';
                }
            }

            function persistFiles(Item, tempZip) {
                let isBinary = Item.mime == false;

                if (Item.mergeFile != '' && Item.mergeFile != undefined) {
                    //empty file means delete operation

                    tempZip.file(Item.fileName, Item.mergeFile, { binary: isBinary }); // if component with fileName does not exist, create it
                    let crc32 = tempZip.crc32(Item.mergeFile, 32);
                    mapCrc32[Item.fileName] = crc32;
                    updateCRC32(Item, crc32);
                } else {
                    //TODO: verify existence
                    tempZip.remove(Item.fileName);
                    Item.crc32 = '';
                }
            }

            function updateZip(archive, Item, context) {
                var fileUpdatedWrapLi = [];

                zip.createReader(
                  new zip.Data64URIReader(archive),
                  function (reader) {
                      var EntryIndex = 0;
                      // get all entries from the zip
                      reader.getEntries(function (entries) {
                          if (entries.length) {
                              var readSingleFile = function () {
                                  if (EntryIndex < entries.length) {
                                      var singleEntry = entries[EntryIndex];
                                      var fileName = singleEntry.filename;

                                      entries[EntryIndex].getData(new zip.TextWriter(), function (TextContent) {
                                          if (!singleEntry.directory) {
                                              var wrap = {};
                                              wrap.fileName = fileName;
                                              wrap.fileText = TextContent;
                                              wrap.crc32 = singleEntry.crc32;
                                              fileUpdatedWrapLi.push(wrap);
                                          }
                                          EntryIndex++;
                                          readSingleFile();
                                      });
                                  } else {
                                      if (fileUpdatedWrapLi.length > 0) {
                                          var addIndex = 0;
                                          var tempWriter;
                                          var newContext;
                                          function nextFile() {
                                              if (addIndex < fileUpdatedWrapLi.length) {
                                                  var fileName = Item.fileName;
                                                  var wrap = fileUpdatedWrapLi[addIndex];
                                                  if (wrap.fileName == fileName) {
                                                      newContext = context;
                                                  } else {
                                                      newContext = wrap.fileText;
                                                  }
                                                  if (Item.mergeFile != '' && Item.mergeFile != undefined) {
                                                      tempWriter.add(wrap.fileName, new zip.TextReader(newContext), function () {
                                                          addIndex++;
                                                          nextFile();
                                                      });
                                                  } else {
                                                      addIndex++;
                                                      nextFile();
                                                  }
                                              } else {
                                                  tempWriter.close(function (base64Data) {
                                                      base64Data = base64Data.slice(base64Data.indexOf(';base64,') + 8);
                                                      zipMap[Item.id] = base64Data;
                                                  });
                                              }
                                          }

                                          function createZipWriter() {
                                              zip.createWriter(
                                                new zip.Data64URIWriter(),
                                                function (writer2) {
                                                    tempWriter = writer2;
                                                    nextFile();
                                                },
                                                function (error) {
                                                    // onerror callback
                                                    console.log('Error while creating zip files for attachments.');
                                                    console.log(error);
                                                    console.log(JSON.stringify(error));
                                                    showErrorMessage(JSON.stringify(error));
                                                }
                                              );
                                          }
                                          createZipWriter();
                                      }
                                  }
                              };
                              readSingleFile();
                          } else {
                              showErrorMessage('Content of component not found.');
                          }
                      });
                  },
                  function (error) {
                      // onerror callback
                      console.log('Error in reading file from attachments.');
                      console.log(error);
                      console.log(JSON.stringify(error));
                      if (error.message != undefined) {
                          showErrorMessage(error.message);
                      } else {
                          showErrorMessage('Unknown error.');
                      }
                  }
                );
            }

            // save 1 merged file back to zip, updates crc32
            function setMergeFile(ItemId, File) {
                // patch var - depricated
                let len = '' + ItemId;

                if (len < 5000) {
                    var bundleItem = bundleComponentStack[ItemId]; // pick up component from ephemeral bundle stack
                    setFile(bundleItem, File);
                    return;
                }

                var Item = componentStack[ItemId]; // long id - general component, short - bundle; short id always temporal (valid only during edition)
                //set file and  update archive
                var archive = zipMap[ItemId]; // for bundle case - updates contents of bundle zip
                if (archive != undefined) {
                    setFile(Item, File);
                    persistFile(Item, archive);
                    updateZip(archive, Item, File);
                    if (Item.compType == 'Profile' || Item.compType == 'PermissionSet') {
                        fileMap[metaFoundMap[Item.id]?.key] = getCrcWithData(Item.mergeFile, { compress: true });
                    } else {
                        fileMap[metaFoundMap[Item.id]?.key].data = Item.mergeFile;
                    }
                    fileMap[metaFoundMap[Item.id]?.key].crc32 = mapCrc32[Item.fileName];
                    metaFoundMap[Item.id].crc32 = Item.crc32;
                }
                Item.isManualMerge = true; // set flag indicated that new merge File has been updated at least once
            }

            function setMergeFiles(masterItem, bundleList) {
                // update archive with data from records with moved = true flag
                var archive = zipMap[masterItem.id]; // for bundle case - updates contents of bundle zip
                if (archive != undefined) {
                    var attZip = new JSZip(archive, { base64: true });

                    var tempZip = null;
                    var isIntermediate = false;
                    // for Aura components and StaticResource with contentType != 'application/zip' add all bundle files directly
                    const isStaticResource = masterItem.compType === 'StaticResource';
                    const isContentTypeZipOrCompressedZip =
                      masterItem.contentType === 'application/zip' || masterItem.contentType === 'application/x-zip-compressed';

                    if (
                      bundleTypesSet.has(masterItem.compType) ||
                      vlocityTypes.includes(masterItem.compType) ||
                      (isStaticResource && !isContentTypeZipOrCompressedZip) ||
                      masterItem.isMetaConflict === true ||
                      isVeevaCommit
                    ) {
                        tempZip = attZip;
                    } else if (isStaticResource && isContentTypeZipOrCompressedZip) {
                        // use itermediate zip, add it as masterItem.fileName to attZip
                        tempZip = new JSZip();
                        isIntermediate = true;
                    } else {
                        console.log('setMergeFiles: empty zip');
                    }

                    mapCrc32 = {}; // empty crc map

                    for (let i = 0; i < bundleList.length; i++) {
                        var bundleComponent = bundleList[i];
                        var bundleItem = bundleComponentStack[i];

                        if (isIntermediate == false) {
                            // update zip with existing components
                            if (bundleComponent.moved == true) {
                                if (bundleComponent.conflictCode == 3) {
                                    //remove comp with uid = i, set MergedFile to null in order to trigger deletion
                                    setFile(bundleItem, '');
                                } else if (bundleComponent.conflictCode == 4 || bundleComponent.conflictCode == 5) {
                                    //added because they are new or replaced
                                    setFile(bundleItem, bundleItem.source);
                                }
                            } else if (bundleComponent.conflictCode != 4) {
                                // add all from source
                                if (bundleComponent.conflictCode != 2) {
                                    setFile(bundleItem, bundleItem.target);
                                }
                            }
                        } else {
                            // fill zip with all source components, process only those which change the content: with conflictCode  = 0,4,5
                            if (bundleComponent.moved == true) {
                                if (bundleComponent.conflictCode == 3) {
                                    // do nothing with component if code is 3 and moved
                                } else if (bundleComponent.conflictCode == 4 || bundleComponent.conflictCode == 5) {
                                    //added because they are new or replaced
                                    setFile(bundleItem, bundleItem.source);
                                }
                            } else if (bundleComponent.conflictCode != 4) {
                                // add all from source
                                if (bundleComponent.conflictCode != 2) {
                                    setFile(bundleItem, bundleItem.target);
                                }
                            }
                        }
                        persistFiles(bundleItem, tempZip);
                        if (isIntermediate == false) {
                            if (masterItem.isMetaConflict == true) {
                                fileMap[bundleItem.compType + '#' + bundleItem.fileName].data = bundleItem.mergeFile;
                                fileMap[bundleItem.compType + '#' + bundleItem.fileName].crc32 = bundleItem.crc32;
                            } else {
                                if (masterItem.compType == 'ExperienceBundle' && bundleItem.fileName == masterItem.fileName + '.site-meta.xml') {
                                    let key = masterItem.fileName.slice(0, masterItem.fileName.lastIndexOf('/'));
                                    if (auraFileMap[key] != undefined && auraFileMap[key][bundleItem.fileName] != undefined) {
                                        auraFileMap[key][bundleItem.fileName].data = bundleItem.mergeFile;
                                        auraFileMap[key][bundleItem.fileName].crc32 = bundleItem.crc32;
                                    }
                                } else {
                                    if (auraFileMap[masterItem.fileName] && auraFileMap[masterItem.fileName][bundleItem.fileName]){
                                        auraFileMap[masterItem.fileName][bundleItem.fileName].data = bundleItem.mergeFile;
                                        auraFileMap[masterItem.fileName][bundleItem.fileName].crc32 = bundleItem.crc32;
                                    } else if (fileMap[bundleItem.compType + '#' + bundleItem.fileName]){
                                        fileMap[bundleItem.compType + '#' + bundleItem.fileName].data = bundleItem.mergeFile;
                                        fileMap[bundleItem.compType + '#' + bundleItem.fileName].crc32 = bundleItem.crc32;
                                    } else {
                                        console.log('setMergeFiles: file not found');
                                    }
                                }
                            }
                        }
                    }
                    // calc and set the composite crc32 sum
                    // Aura - use polynomial summing
                    // Static - use JSZip method
                    if (isIntermediate == true) {
                        var z = tempZip.generate({ base64: false, compression: 'DEFLATE' });
                        fileMap[metaFoundMap[masterItem.id]?.key] = getCrcWithData(z, { isInnerZip: true });
                        attZip.file(masterItem.fileName, z, { binary: true }); // put zip inside zip
                    }
                    var b64 = attZip.generate({ type: 'base64', compression: 'DEFLATE' }); //repack zip
                    zipMap[masterItem.id] = b64;

                    const isNeedComposeBundleCrc =
                      bundleTypesSet.has(masterItem.compType) || vlocityTypes.includes(masterItem.compType) || isVeevaCommit;

                    if (isNeedComposeBundleCrc) {
                        masterItem.crc32 = composeBundleCrc(mapCrc32);
                    } else if (masterItem.isMetaConflict == true && bundleComponentStack.length == 2) {
                        var crc32_2 = bundleComponentStack[0].crc32 + ' ' + bundleComponentStack[1].crc32;
                        updateCRC32Meta(masterItem, crc32_2);
                    } else if (isIntermediate == true) {
                        let crc32_1 = fileMap[masterItem.compType + '#' + masterItem.fileName].crc32;
                        updateCRC32(masterItem, crc32_1);
                    } else {
                        if (bundleComponentStack != undefined && bundleComponentStack.length > 0) {
                            let crc32_1 = bundleComponentStack[0].crc32;
                            updateCRC32(masterItem, crc32_1);
                        }
                    }
                    metaFoundMap[masterItem.id].crc32 = masterItem.crc32;
                }
            }

            function setBkUp(Id, xmlBk) {
                if (Id.length > 4) {
                    var descriptor = componentStack[Id];
                } else {
                    var descriptor = bundleComponentStack[Id];
                }
                if (descriptor != undefined) {
                    descriptor.bkUp = xmlBk;
                } else {
                    console.log('error: descriptor is null');
                }
            }

            return {
                addZips: function (zip1, context, comp) {
                    // adds the zip; if exists, update with a new data
                    return new Promise(function (resolve, reject) {
                        if (componentStack[comp.id] != undefined) {
                            counter++;
                        }
                        extractFile(zip1, context, comp).then(function () {
                            resolve();
                        });
                    });
                },
                updateTargetZip: function (compId, data) {
                    //  update with a new data
                    if (componentStack[compId] != undefined) {
                        componentStack[compId][1] = data;
                    }
                },
                setMergeFile: function (ItemId, File, patch) {
                    setMergeFile(ItemId, File, patch);
                },
                setMergeFiles: function (item, bundle) {
                    setMergeFiles(item, bundle);
                },
                setBkUp: function (Id, xmlBk) {
                    setBkUp(Id, xmlBk);
                },
                getZipDescription: function (compId) {
                    return componentStack[compId];
                },
                getAllZipDescription: function () {
                    return componentStack;
                },
                getZip: function (attId) {
                    return zipMap[attId];
                },
                setZip: function (attId, data) {
                    zipMap[attId] = data;
                },
                getLength: function (attId) {
                    if (zipMap[attId] != undefined) {
                        return zipMap[attId].length;
                    } else {
                        return 0;
                    }
                },
                initArchiveService: function () {
                    componentStack = {};
                    zipMap = {};
                    counter = 0;
                },
                removeStack: function (compId) {
                    if (componentStack[compId] != undefined) {
                        componentStack[compId] = undefined;
                    }
                },
                inStack: function (compId) {
                    return componentStack[compId] != undefined;
                }
            };
        });

        myApp.factory('CacheService', function ($q) {
            var archive = {}; // map compId => compressed data
            var counter = 0;
            var callFunct;

            function _getData(compId, callback) {
                callFunct = callback; // set function to return data
                var returnObj = {};
                if (archive[compId] != undefined) {
                    returnObj = JSON.parse(pako.inflate(archive[compId], { to: 'string' }));
                }
                callFunct(returnObj);
            }

            return {
                pop: function (compId, callback) {
                    _getData(compId, function (data) {
                        callback(data);
                    });
                },
                push: function (compId, data) {
                    var compressedData = JSON.stringify(data);
                    if (archive[compId] == undefined) {
                        counter++;
                    }
                    archive[compId] = pako.deflate(compressedData, { to: 'string' });
                },
                initCacheService: function () {
                    archive = {};
                    counter = 0;
                },
                isCached: function (compId) {
                    return archive[compId] != undefined;
                }
            };
        });

