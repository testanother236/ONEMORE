    <script>
        sforce.connection.sessionId='{!GETSESSIONID()}';
        $( document ).ready(function() {
            overridePageMessages();
        });
        const vlocityParam = '{!JSENCODE(metadataType)}';
        const locale = '{!JSENCODE(locale)}';
        const timezone = '{!JSENCODE(timezone)}';

        if (typeof jQuery != 'undefined') {
            $j = jQuery.noConflict();
        }

        function getDate(jsonDate) {
            try {
                if (locale && timezone) {
                    return new Date(jsonDate).toLocaleString(locale, { timeZone: timezone });
                }
            } catch (e) {}
            return new Date(jsonDate).toUTCString();
        }

        function correctDate(list) {
            for (var i = 0; i < list.length; i++) {
                var jsonDate = list[i].changedOn;
                if (jsonDate != undefined) {
                    list[i].changedOnTxt = getDate(jsonDate);
                }
            }
        }

        var nSelected = 0;

        function gotoPreviousPage() {
            ////////console.log('gotoPreviousPage');
            getScope().CommitStep = 0;
            getScope().initialize();
        }

        function filterList(val) {
            ////////console.log('filterList:'+val);
            getScope().typeFilter = val;
            getScope().applyFilter();
        }

        function updateAllChecked() {
            getScope().updateAccumulator();
        }

        const ZIPPACK_LIMIT = 2500000;
        const xmlName = 'package.xml';
        const apiVersion = {!localApiVersion};
        var sessionId = "{!$Api.Session_Id}";

        Visualforce.remoting.timeout = 120000;
        var totalRecords = 0;
        var NameSpacePrefix = '{!JSENCODE(nameSpacePrefix)}';
        const isVlocityCommit = {!isVlocity};
        const isVeevaCommit = {!isVeevaType};
        const snapshotName = '{!JSENCODE(snapName)}';

        zip.workerScripts = {
            deflater: ['res/js/workers/z-worker.js', 'res/js/workers/deflate.js'],
            inflater: ['res/js/workers/z-worker.js', 'res/js/workers/inflate.js']
        };

        zip.useWebWorkers = false;

        var zipWriter,
          writer,
          creationMethod,
          URL = window.webkitURL || window.mozURL || window.URL;

        var attList = [];
        var metaItemList = [];
        var metaFoundMap = {};
        var fileMap = {};
        var auraFileMap = {};
        var allCompMap = {};
        var allCompFilter = {};
        var allCompTypeFilter = {};
        var normalZip = new JSZip();
        var ComponentAttachmentWraperList = [];
        var isPatchCreated = false;

        var folderMap = new Object();
        folderMap['DocumentFolder'] = 'Document';
        folderMap['DashboardFolder'] = 'Dashboard';
        folderMap['ReportFolder'] = 'Report';
        folderMap['EmailFolder'] = 'EmailTemplate';
        folderMap['EmailTemplateFolder'] = 'EmailTemplate';

        var revFolderMap = new Object();
        revFolderMap['Document'] = true;
        revFolderMap['Dashboard'] = true;
        revFolderMap['Report'] = true;
        revFolderMap['EmailTemplate'] = true;

        var CTP_subFolderTypeMap = {};
        CTP_subFolderTypeMap['Dashboard'] = 'Dashboard';
        CTP_subFolderTypeMap['DashboardFolder'] = 'DashboardFolder';
        CTP_subFolderTypeMap['Report'] = 'Report';
        CTP_subFolderTypeMap['ReportFolder'] = 'ReportFolder';
        CTP_subFolderTypeMap['EmailTemplateFolder'] = 'EmailTemplateFolder';
        CTP_subFolderTypeMap['EmailTemplate'] = 'EmailTemplate';

        const bundleTypes = JSON.parse('{!JSENCODE(bundleTypesListJSON)}');

        const vlocityTypes = JSON.parse('{!JSENCODE(vlocityTypeListJSON)}');

        const AUTORESOLVED = 'Conflict, Changed by same User';
        const CONFLICT = 'Conflict';
        const NEW = 'New';
        const MERGED = 'Merged';
        const RESOLVED = 'Resolved';
        const THEME = '{!$User.UIThemeDisplayed}';

        var errorCode = '';
        zip.workerScriptsPath = "{!URLFOR($Resource.zipp,'res/js/workers')}/";
        var logIdSaveAtt = '';
        var tempAttBase64 = '';

        const typesWithMeta = {
            'ApexClass': true,
            'ApexTrigger': true,
            'ApexComponent': true,
            'ApexPage': true,
            'EmailTemplate': true,
            'StaticResource': true,
            'Document': true,
            'WaveComponent': true
        };

        const bundleTypesSet = new Set(JSON.parse('{!JSENCODE(bundleTypesListJSON)}'));

        const notEditableLi = {
            'Document': true
        };


        let isModalOpen = false;

        function showErrorMessage(str) {
            if ($j('#msg') != undefined) {
                $j('#msg').remove();
            }
            var parentVal = $j("[id$='msg']");
            if(parentVal != undefined)
            {
                var childVal = '<span id="msg">'+
                                '<span>'+
                                    '<div class="message errorM3" role="alert">'+
                                        '<table border="0" cellpadding="0" cellspacing="0" class="messageTable" style="padding:0px;margin:0px;">'+
                                            '<tbody>'+
                                                '<tr valign="top">'+
                                                '<td>'+
                                                    '<img alt="ERROR" class="msgIcon" src="/s.gif" title="ERROR">'+
                                                '</td>'+
                                                '<td class="messageCell">'+
                                                    '<div class="messageText">'+
                                                        '<span style="color:#cc0000">'+
                                                            '<h4>Error:</h4>'+
                                                        '</span>'+
                                                        str+'<br>'+
                                                    '</div>'+
                                                '</td>'+
                                                '</tr>'+
                                                '<tr>'+
                                                    '<td></td>'+
                                                    '<td></td>'+
                                                '</tr>'+
                                            '</tbody>'+
                                        '</table>'+
                                    '</div>'+
                                '</span>'+
                            '</span>';
                 parentVal.before(childVal);
            }
            unbindWindow();
        }

        var commitIds,
          bodySize,
          componentMetaMap,
          metaIds,
          fileIndex,
          excludedFiles,
          commitSuccess,
          branchId,
          currentIndex,
          buildLogId;

        /******             angularJs modules description               ******/

        var myApp = angular.module('snapCommit', ['base64']);

        myApp.$inject = ['$scope', '$filter', '$controller', 'CacheService', 'ArchiveService'];

        myApp.service('dataManager', function ($q) {
            return {
                getAllItems: function () {
                    var deferred = $q.defer();
                    var snapId = '{!JSENCODE(snapId)}';
                    if (snapId == undefined || snapId == '') {
                        snapId = '';
                    }
                    try {
                        (async () => {
                            const result = [];
                            let lastId = '';
                            const method = '{!$RemoteAction.SnapshotToBranchCommitController.getAllItems}';

                            do {
                                const chunk = await this.callController(method, snapId, '{!JSENCODE(metadataType)}', lastId);
                                lastId = chunk?.lastId;
                                if (Array.isArray(chunk?.metaItemListId)) {
                                    result.push(...chunk?.metaItemListId);
                                }
                            } while (lastId && lastId.length);
                            deferred.resolve(result);
                        })();
                    } catch (e) {
                        console.log('--- getAllItems error');
                        deffered.reject(e);
                    }
                    return deferred.promise;
                },
                getItems: function (list) {
                    var deferred = $q.defer();
                    var snapId = '{!JSENCODE(snapId)}';
                    if (snapId == undefined || snapId == '') {
                        snapId = '';
                    }
                    Visualforce.remoting.Manager.invokeAction(
                      '{!$RemoteAction.SnapshotToBranchCommitController.getItems}',
                      snapId,
                      JSON.stringify(list),
                      '{!JSENCODE(metadataType)}',
                      function (result, event) {
                          if (event.status) {
                              deferred.resolve(result);
                          } else {
                              deferred.reject(event);
                          }
                      }
                    );

                    return deferred.promise;
                },
                getComparison: function (list) {
                    var deferred = $q.defer();
                    ////////console.log('br='+branchRef);
                    ////////console.log('snapId='+snapRef);
                    Visualforce.remoting.Manager.invokeAction(
                      '{!$RemoteAction.SnapshotToBranchCommitController.getComparison}',
                      snapRef,
                      branchRef,
                      JSON.stringify(list),
                      '{!JSENCODE(metadataType)}',
                      function (result, event) {
                          if (event.status) {
                              deferred.resolve(result);
                          } else {
                              deferred.reject(event);
                          }
                      }
                    );

                    return deferred.promise;
                },
                callController: function (...args) {
                    return new Promise((resolve, reject) => {
                        const controllerFunction = args[0],
                          params = args.slice(1);

                        Visualforce.remoting.Manager.invokeAction(controllerFunction, ...params, function (result, event) {
                            if (event.status) {
                                resolve(result);
                            } else {
                                reject(event);
                            }
                        });
                    });
                },
                getAttachments: function (compHistId) {
                    var deferred = $q.defer();
                    Visualforce.remoting.Manager.invokeAction(
                      '{!$RemoteAction.SnapshotToBranchCommitController.getComponentAttachment}',
                      compHistId,
                      function (result, event) {
                          if (event.status) {
                              if (result != undefined && result.length > 0) {
                                  deferred.resolve(result);
                              } else {
                                  deferred.reject('Attachment not found.');
                              }
                          } else {
                              deferred.reject(event);
                          }
                      }
                    );
                    return deferred.promise;
                }
            };
        });

        myApp.directive('postrenderAction', postrenderAction);

        /* @ngInject */
        function postrenderAction($timeout) {
            // Directive Interface
            // Defines base properties for the directive.
            var directive = {
                restrict: 'A',
                priority: 101,
                link: link
            };
            return directive;

            // Link Function
            // Provides functionality for the directive during the DOM building/data binding stage.
            function link(scope, element, attrs) {
                $timeout(function () {
                    scope.$evalAsync(attrs.postrenderAction);
                }, 0);
            }
        }

        var app = myApp.controller(
          'Snap2BranchCommitControllerAJS',
          function (
            $scope,
            $base64,
            $controller,
            dataManager,
            CacheService,
            ArchiveService,
            $filter,
            $interval,
            $timeout,
            filterFilter
          ) {
              $scope.componentBaseList = [];
              $scope.componentListPtr = [];

              $scope.componentList = []; // type ConflictWrapper
              $scope.newCompList = []; // type SafeCommitCompWrapper
              $scope.notMergeCompList = []; // type NotCommitCompWrapper

              $scope.attIdMap = {};
              $scope.globalAttIdMap = {};

              $scope.componentListShow = true;
              $scope.componentShow = true;
              $scope.newCompShow = true;
