<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <description>EmailAlertOnPeerReviewerInsert</description>
        <fullName>EmailAlertOnPeerReviewerInsert</fullName>
        <protected>false</protected>
        <recipients>
            <field>User__c</field>
            <type>userLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Flosum/PeerReviewerInsert</template>
    </alerts>
    <alerts>
        <description>EmailAlertOnReviewerApprove</description>
        <fullName>EmailAlertOnReviewerApprove</fullName>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Flosum/PullRequestApprovedByReviewer</template>
    </alerts>
    <alerts>
        <description>EmailAlertOnReviewerReject</description>
        <fullName>EmailAlertOnReviewerReject</fullName>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>Flosum/PullRequestRejectedByReviewer</template>
    </alerts>
    <rules>
        <actions>
            <name>EmailAlertOnReviewerApprove</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Pull_Request_Reviewer__c.Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <fullName>OnReviewerApprove</fullName>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <actions>
            <name>EmailAlertOnReviewerReject</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Pull_Request_Reviewer__c.Status__c</field>
            <operation>equals</operation>
            <value>Reject</value>
        </criteriaItems>
        <fullName>OnReviewerReject</fullName>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
